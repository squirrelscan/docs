{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "SquirrelScan",
  "description": "CLI SEO Audits for Agents & LLMs",
  "colors": {
    "primary": "#689B6C",
    "light": "#F5F5F0",
    "dark": "#1F1F3D"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "JetBrains Mono",
    "heading": {
      "family": "JetBrains Mono",
      "weight": 600
    },
    "body": {
      "family": "JetBrains Mono",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#F5F5F0",
      "dark": "#0e0e10"
    }
  },
  "rounded": "none",
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart",
          "configuration"
        ]
      },
      {
        "group": "CLI",
        "pages": [
          "cli/init",
          "cli/config"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "crawl"
        ]
      },
      {
        "group": "CLI Reference",
        "pages": [
          "cli/audit"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://squirrelscan.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/squirrelscan/squirrelscan"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "mcp",
      "cursor"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/squirrelscan",
      "x": "https://x.com/squirrelscan"
    }
  },
  "icons": {
    "library": "lucide"
  }
}
